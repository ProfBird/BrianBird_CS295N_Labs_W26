@model List<Submission>
@{
    ViewData["Title"] = "Submissions";
}
<div class="text-center">
    <h1>Code Submissions</h1>
    <a asp-action="Index">Back to Reviews Main Page</a>
</div>
@if (Model.Count == 0)
{
    <p class="text-center">No submissions yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Student</th>
                <th>Assignment</th>
                <th>Version</th>
                <th>Submission Date</th>
                <th>Code URL</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var submission in Model)
            {
                <tr>
                    <td>@submission.Student?.Name</td>
                    <td>@submission.Assignment?.AssignmentName</td>
                    <td>@(submission.Version ?? "N/A")</td>
                    <td>@submission.SubmissionDate.ToString("d")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(submission.CodeUrl))
                        {
                            var url = submission.CodeUrl;
                            if (!url.StartsWith("http://") && !url.StartsWith("https://"))
                            {
                                url = "https://" + url;
                            }
                            <a href="@url" target="_blank">@submission.CodeUrl</a>
                        }
                        else
                        {
                            <text>None</text>
                        }
                    </td>
                    <td>
                        <a asp-action="Review" asp-route-id="@submission.SubmissionId" class="btn btn-sm btn-primary">Review</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
