@model CodeReviews.Models.ReadinessResultVM

@{
    ViewData["Title"] = "Readiness Result";
    var statusClass = Model.Status switch
    {
        "Ready" => "success",
        "Almost Ready" => "warning",
        _ => "danger"
    };
}

<div class="container mt-4">
    <h2>Your Readiness Result</h2>

    <div class="alert alert-@statusClass mt-4" role="alert">
        <h4 class="alert-heading">@Model.Status</h4>
        <p>@Model.Message</p>
        <hr>
        <p class="mb-0">Score: <strong>@Model.Score / @Model.MaxScore</strong> (@String.Format("{0:P0}", (double)Model.Score / Model.MaxScore))</p>
    </div>

    @if (Model.Recommendations.Any())
    {
        <div class="card mt-4">
            <div class="card-header bg-info text-white">
                <h5>Recommendations</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var recommendation in Model.Recommendations)
                    {
                        <li class="list-group-item">@recommendation</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-primary">Check Again</a>
        @if (Model.Status == "Ready")
        {
            <a href="#" class="btn btn-success">Request Code Review</a>
        }
    </div>

    @if (Model.Checklist != null)
    {
        var selectionMap = Model.Checklist.Selections.ToDictionary(
            selection => selection.Title,
            selection => selection.IsChecked,
            StringComparer.OrdinalIgnoreCase);

        <div class="card mt-4">
            <div class="card-header">
                <h5>Your Checklist Summary</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var category in Model.Checklist.Categories)
                    {
                        <div class="col-md-6">
                            <h6>@category.Name</h6>
                            <ul class="list-unstyled">
                                @foreach (var item in Model.Checklist.Items.Where(item => item.Category == category.Id))
                                {
                                    var isChecked = selectionMap.TryGetValue(item.Title, out var selected) && selected;
                                    <li>@(isChecked ? "[x]" : "[ ]") @item.Text</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
